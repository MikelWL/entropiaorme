        "required": [
          "status",
          "sessionId"
        ],
        "title": "SessionDeletedResult",
        "type": "object"
      },
      "TrackingSnapshot": {
        "additionalProperties": true,
        "description": "The consolidated dashboard hydration shape.\n\nThe union of the status, live, and recent-events readouts in one response:\na newly mounted dashboard hydrates from this once, then reacts to pushed\nevents rather than re-polling. Casing is preserved from the readouts it\nunions: ``session_id`` / ``started_at`` / ``kill_count`` stay snake-case,\nthe headline numbers stay camelCase. Polymorphic across the three states;\nserved with ``response_model_exclude_unset=True`` so each state keeps its\nown shape.",
        "properties": {
          "cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost"
