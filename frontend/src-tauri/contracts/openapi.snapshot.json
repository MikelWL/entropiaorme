          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum entries per page (default 50, capped at 200).",
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LedgerItem"
                  },
                  "title": "Response Demo List Ledger Api Demo Analytics Ledger Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Next-Cursor": {
                "description": "Cursor for the next page; absent on the last page.",
                "required": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Demo List Ledger",
        "tags": [
          "demo"
        ]
