      "NotableEvent": {
        "additionalProperties": true,
        "description": "A dashboard activity-feed entry.\n\nCovers both the notable-event payload (global/HoF/quest) and the tracker\nwarning entry, which share ``type``/``description``/``value`` and differ in\nthe optional ``eventType``/``timestamp``/``id`` keys.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "eventType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eventtype"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          },
          "type": {
            "title": "Type",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "type",
          "description",
          "value"
        ],
        "title": "NotableEvent",
        "type": "object"
      },
      "SessionDeletedResult": {
        "additionalProperties": true,
        "description": "Acknowledgement that a session was deleted (2-key).",
        "properties": {
          "sessionId": {
            "title": "Sessionid",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
