*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
# Frontend text sources: keep LF on every platform so Biome's `lineEnding: lf`
# check passes identically on Windows checkouts, whose default CRLF would
# otherwise report spurious whole-file format diffs.
*.ts text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.svelte text eol=lf
*.css text eol=lf
# SQLite stores migration statement text verbatim in sqlite_master, so the
# schema-identity checks need the .sql sources byte-stable across platforms.
*.sql text eol=lf
# Migration 0028's SHA-384 identity includes its trailing blank line, so Git
# must not flag that exact byte as drift.
app/src-tauri/eo-services/migrations/0028_quest_reward_provenance.sql whitespace=-blank-at-eof
# Bundled native binaries (the ONNX Runtime + DirectML libraries and the OCR
# model): always binary, never line-ending- or text-normalised.
*.dll binary
*.so binary
*.onnx binary
